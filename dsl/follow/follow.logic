# Follow loop decisions.
# Host: src/biome_mcp/cli/follow.py

DECISION is_done DEFAULT false
  status AT 10 WHEN follow.result_status IN {"done", "complete", "finished"} -> true
  polls AT 20 WHEN follow.max_polls_present AND follow.poll >= follow.max_polls -> true
END

DECISION is_fatal DEFAULT false
  errors AT 10 WHEN follow.consecutive_errors > follow.max_retries -> true
END

