# Follow loop decisions.

DECISION is_done DEFAULT false
  WHEN result.status IN {"done", "complete", "finished"} -> true
  WHEN max_polls != null AND poll >= max_polls -> true
END

DECISION is_fatal DEFAULT false
  WHEN consecutive_errors > max_retries -> true
END

GIVEN followLoop
  WHEN poll_tool
    THEN poll += 1
    THEN consecutive_errors = result.error ? consecutive_errors + 1 : 0
    THEN DECISION is_fatal -> stop(exit=1)
    THEN DECISION is_done -> stop(exit=0)
END

GIVEN followLoop
  WHEN retry
    THEN sleep(interval)
    THEN poll_tool
END
