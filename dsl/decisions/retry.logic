# Engine-agnostic retry gate: error code and attempt count decide.
# Engine adapters add domain-specific rules (Unity: domainReload, Browser: cdpDisconnected).
DECISION retryGate DEFAULT fail
  maxRetries AT 5 WHEN retry.attempt >= retry.maxRetries -> max_retries
  connectionLost AT 10 WHEN retry.errorCode == connection_lost -> retry
  timeout AT 20 WHEN retry.errorCode == timeout -> retry
  cancelled AT 30 WHEN retry.errorCode == cancelled -> fail
  invalidArgs AT 40 WHEN retry.errorCode == invalid_arguments -> fail
  permissionDenied AT 50 WHEN retry.errorCode == permission_denied -> fail
  commandNotFound AT 60 WHEN retry.errorCode == command_not_found -> fail
END
