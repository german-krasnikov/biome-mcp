DSL 1
# env_aliases: list of EnvAlias records — expressed as [EnvAlias] in the AppProfile below.
RECORD EnvAlias
  var_name: string
  suffix: string
END

RECORD AppProfile
  app_name: string
  protocol: string
  default_port: int
  default_host: string
  data_dir: string
  env_aliases: [EnvAlias]
END
