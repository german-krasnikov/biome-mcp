# TcpSession connection decision.
# Host: src/biome_mcp/transport/persistent.py

DECISION is_connected DEFAULT false
  connected AT 10 WHEN tcpSession.reader_present AND tcpSession.writer_present -> true
END

# Host mutations (not compiled — reference for Python implementation):
# GIVEN call(payload, timeout) -> if DECISION is_connected: frame_write + frame_read
#   ON ConnectionError -> reconnect, retry once
#   ON second failure  -> raise ConnectionError
# GIVEN connect -> reader, writer = open_connection(host, port)
# GIVEN close   -> writer.close(), writer = None, reader = None
