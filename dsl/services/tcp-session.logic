# TcpSession reconnect-once strategy.

DECISION is_connected DEFAULT false
  WHEN reader != null AND writer != null -> true
END

GIVEN tcpSession
  WHEN call(payload, timeout)
    THEN DECISION is_connected -> frame_write(payload) + frame_read(timeout)
    THEN ON ConnectionError -> reconnect, retry once
    THEN ON second failure -> raise ConnectionError
END

GIVEN tcpSession
  WHEN connect
    THEN reader, writer = open_connection(host, port)
    THEN apply_socket_options(writer.socket)
END

GIVEN tcpSession
  WHEN close
    THEN writer.close(), writer = None, reader = None
END
