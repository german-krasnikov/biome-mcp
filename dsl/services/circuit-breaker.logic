# CircuitBreaker state transitions.

DECISION is_open DEFAULT false
  WHEN state == "open" -> true
END

DECISION allow_request DEFAULT false
  WHEN state == "closed" -> true
  WHEN state == "open" AND elapsed(opened_at) >= cooldown -> release_probe
END

DECISION should_open DEFAULT false
  WHEN failures >= threshold -> true
END

GIVEN circuitBreaker
  WHEN record_success
    THEN state = "closed", failures = 0
END

GIVEN circuitBreaker
  WHEN record_failure
    THEN failures += 1
    THEN DECISION should_open -> state = "open", opened_at = now()
END

GIVEN circuitBreaker
  WHEN reset
    THEN state = "closed", failures = 0, opened_at = 0.0
END
