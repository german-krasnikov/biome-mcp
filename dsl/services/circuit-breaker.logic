# CircuitBreaker state decisions.
# Host: src/biome_mcp/circuit_breaker.py

DECISION is_open DEFAULT false
  open AT 10 WHEN circuitBreaker.state == open -> true
END

DECISION allow_request DEFAULT false
  closed AT 10 WHEN circuitBreaker.state == closed -> true
  probe AT 20 WHEN circuitBreaker.state == open AND circuitBreaker.cooldown_elapsed -> true
END

DECISION should_open DEFAULT false
  threshold AT 10 WHEN circuitBreaker.failures >= circuitBreaker.threshold -> true
END

# Host mutations (not compiled — reference for Python implementation):
# GIVEN record_success  -> state = "closed", failures = 0
# GIVEN record_failure  -> failures += 1; if DECISION should_open -> state = "open", opened_at = now()
# GIVEN reset           -> state = "closed", failures = 0, opened_at = 0.0
